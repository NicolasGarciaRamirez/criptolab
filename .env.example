# Variables de Docker Compose. Copia este archivo como .env.
# No contiene secretos reales: cambia la contraseña en entornos compartidos.
APP_PORT=8080
APP_URL=http://localhost:8080

# UID/GID del usuario que ejecuta Docker en Linux. Ajusta si tu usuario no es 1000.
UID=1000
GID=1000

POSTGRES_DB=criptografia
POSTGRES_USER=criptografia
POSTGRES_PASSWORD=change-me-local

ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
